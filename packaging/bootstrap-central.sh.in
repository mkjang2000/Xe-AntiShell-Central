#!/usr/bin/env bash
# Generated by the publisher for one release. Only the embedded RPM hashes are trusted.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
tag='@CENTRAL_TAG@'
if [[ ${1:-} != --confirm || $# != 1 ]]; then
  printf 'Usage: sudo bash %s --confirm\nBacks up and upgrades the existing central server to %s.\n' "${0##*/}" "$tag" >&2
  exit 2
fi
(( EUID == 0 )) || { echo 'Central bootstrap requires root.' >&2; exit 1; }
if [[ -S /run/xe-antishell-central-updater.sock ]]; then
  exec /usr/sbin/sentinel-central update apply --tag "$tag"
fi
[[ $(uname -m) == x86_64 ]] || { echo 'This release requires x86_64.' >&2; exit 1; }
major=$(rpm -q --qf '%{RELEASE}' xe-antishell-central)
case "$major" in
  *.el9) major=9; digest='@CENTRAL_EL9_SHA256@' ;;
  *.el10) major=10; digest='@CENTRAL_EL10_SHA256@' ;;
  *) echo 'An installed EL9/EL10 central RPM is required.' >&2; exit 1 ;;
esac
version=${tag#v}
name=xe-antishell-central-${version%-r*}-${version##*-r}.el$major.x86_64.rpm
url="https://github.com/mkjang2000/Xe-AntiShell-Central/releases/download/$tag/$name"
umask 077
# Use an executable root-owned filesystem on hosts with noexec /tmp.
work=$(mktemp -d /var/lib/.xeas-central-bootstrap.XXXXXXXX)
trap 'rm -rf -- "$work"' EXIT
fetch() {
  curl --disable --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    --connect-timeout 15 --max-time 300 --max-filesize "$3" --output "$2" -- "$1"
}
fetch "$url" "$work/$name" 67108864
actual=$(sha256sum < "$work/$name")
[[ ${actual%% *} == "$digest" ]] || { echo 'Central bootstrap RPM checksum mismatch.' >&2; exit 1; }
fetch "$url.manifest.json" "$work/$name.manifest.json" 16384
rpm2cpio "$work/$name" | cpio --quiet --extract --to-stdout './usr/sbin/sentinel-central' > "$work/sentinel-central"
[[ -s "$work/sentinel-central" ]] || { echo 'Central bootstrap binary missing from RPM.' >&2; exit 1; }
chmod 0700 "$work/sentinel-central"
"$work/sentinel-central" update bootstrap --confirm --rpm "$work/$name" --manifest "$work/$name.manifest.json"
